rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get the user's role from tenant user profile
    function getUserRole(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/users/$(request.auth.uid)).data.role;
    }

    function isAdmin(tenantId) {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        getUserRole(tenantId) == 'admin'
      );
    }

    function isSupervisor(tenantId) {
      return isAuthenticated() && (
        request.auth.token.role == 'supervisor' ||
        request.auth.token.role == 'manager' ||
        getUserRole(tenantId) == 'supervisor' ||
        getUserRole(tenantId) == 'manager'
      );
    }

    function isStaffOrManager(tenantId) {
      return isAdmin(tenantId) || isSupervisor(tenantId);
    }

    function isCashier(tenantId) {
      return isAuthenticated() && (
        request.auth.token.role == 'cashier' ||
        getUserRole(tenantId) == 'cashier'
      );
    }

    // Tenant boundary isolation
    match /tenants/{tenantId} {
      allow read, write: if isAdmin(tenantId);

      // Settings
      match /settings/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin(tenantId);
      }

      // Users
      match /users/{userId} {
        allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin(tenantId));
        allow write: if isAdmin(tenantId);
      }

      // Products & Categories
      match /products/{productId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin(tenantId);
      }
      match /categories/{categoryId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin(tenantId);
      }
      match /brands/{brandId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin(tenantId);
      }

      // Sales
      match /sales/{saleId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (isAdmin(tenantId) || isCashier(tenantId));
        allow update, delete: if isAdmin(tenantId);
      }

      // Inventory
      match /inventory/{logId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin(tenantId);
      }

      // Customers
      match /customers/{customerId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated();
        allow delete: if isAdmin(tenantId);
      }

      // Notifications
      match /notifications/{notifId} {
        allow read, write: if isAuthenticated();
      }

      // Expenses & Purchases
      match /expenses/{expenseId} {
        allow read, write: if isAdmin(tenantId);
      }
      match /purchases/{purchaseId} {
        allow read, write: if isAdmin(tenantId);
      }
      match /suppliers/{supplierId} {
        allow read, write: if isAdmin(tenantId);
      }
    }
  }
}
